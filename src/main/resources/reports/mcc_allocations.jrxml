	<parameter name="logo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select al.farmer_name as farmer, al.farmer_no as fno,al.amount, al.product_name as product, al.quantity as qty, al.status, date(al.approval_date) as approval_date, r.route from farmer_product_allocations al join farmer f on al.farmer_no=f.farmer_no join route r on f.route_fk=r.id join pick_up_locations p on al.location_id = p.id where al.status='APPROVED' and al.location_id = $P{locationId}  and monthname(al.approval_date)=$P{month} and year(al.approval_date)=$P{year}]]>
	</queryString>
	<field name="farmer" class="java.lang.String"/>
	<field name="product" class="java.lang.String"/>
	<field name="qty" class="java.lang.Integer"/>
