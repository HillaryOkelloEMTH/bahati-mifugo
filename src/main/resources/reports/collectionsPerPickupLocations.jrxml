	<parameter name="company" class="java.lang.String"/>
	<parameter name="locationid" class="java.lang.Long"/>
	<parameter name="location" class="java.lang.String"/>
	<parameter name="address" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="date" class="java.lang.String"/>
	<parameter name="pickupLocation" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	f.first_name,
	f.last_name,
	f.farmer_no,
	c.original_quantity AS originalQuantity,
	c.SESSION as session,
	c.id,
	c.collection_number AS collection_number,
	c.EVENT,
	c.current_price AS current_price,
	c.product_type AS productType,
	c.payment_status AS paymentStatus,
	f.id AS farmerId,
	u.user_name AS collector,
	f.username AS farmer,
	c.amount,
	c.quantity,
	c.collection_date as collectionDate,
	r.route AS route
FROM
	collections c
	JOIN users u ON c.collector_id = u.id
	JOIN farmer f ON f.farmer_no = c.farmer_no
	JOIN route r ON r.id = c.route_fk
WHERE
	DATE ( c.collection_date )= $P{date}
	AND r.id = $P{locationid}
ORDER BY
	c.collection_date]]>
	</queryString>
