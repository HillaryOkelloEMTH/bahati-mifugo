	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="159"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="833"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="496"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="490"/>
	<property name="com.jaspersoft.studio.report.description" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Jufred Database.jrdax"/>
	<parameter name="company" class="java.lang.String"/>
	<parameter name="location" class="java.lang.String"/>
	<parameter name="address" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="month" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT f.farmer_no, f.mobile_no, f.username, 
COALESCE(SUM(c.quantity), 0.0) AS quantity, 
COALESCE(SUM(a.advance_amount), 0.0) AS advance_amount, ((COALESCE(SUM(c.amount), 0.0)) - (COALESCE(SUM(a.advance_amount), 0.0))) AS net_payable 
FROM farmer f LEFT JOIN collections c ON f.farmer_no = c.farmer_no LEFT JOIN advance_payment a ON f.farmer_no = a.farmer_no 
WHERE f.farmer_no IS NOT NULL AND f.payment_mode ='MPESA' AND MONTHNAME(c.collection_date) = $P{month} AND YEAR(c.collection_date) = YEAR(NOW())
GROUP BY f.farmer_no;]]>
	</queryString>
