	<parameter name="farmerId" class="java.lang.Integer"/>
	<parameter name="from" class="java.lang.String"/>
	<parameter name="to" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT f.username as farmer, c.SESSION, c.quantity, c.current_price, c.amount, DATE_FORMAT(c.collection_date, '%Y-%m-%d') AS DATE, c.collection_number AS deliveryNumber, u.user_name, r.route AS route FROM collections c JOIN farmer f ON c.farmer_no = f.farmer_no JOIN users u ON u.id = c.collector_id JOIN route r ON r.id = c.route_fk WHERE f.farmer_no=$P{farmerId} and date(c.collection_date) between $P{from} and $P{to} GROUP BY c.collection_number ORDER BY c.collection_date]]>
	</queryString>
