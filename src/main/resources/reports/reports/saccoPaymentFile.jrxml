	<parameter name="address" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="month" class="java.lang.String"/>
	<parameter name="bank" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT b.account_number AS account_number, b.branch AS branch, f.username AS username, ((COALESCE(ROUND(SUM(c.amount), 2), 0.0))-(COALESCE(ROUND(adv.advance_amount, 2), 0.0))) AS net_payable FROM farmer f LEFT JOIN(SELECT farmer_no, SUM(advance_amount) AS advance_amount FROM advance_payment GROUP BY farmer_no) AS adv ON f.farmer_no=adv.farmer_no JOIN collections c ON f.farmer_no=c.farmer_no JOIN bank_details b ON f.farmer_no=b.id WHERE MONTHNAME(c.collection_date)=$P{month} AND b.bank_name=$P{bank} GROUP BY f.farmer_no;]]>
	</queryString>
