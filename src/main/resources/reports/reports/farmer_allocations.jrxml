	<parameter name="farmerNo" class="java.lang.String"/>
	<parameter name="from" class="java.lang.String"/>
	<parameter name="to" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select product_name, amount, date(approval_date) as allocated_on, quantity from farmer_product_allocations where  date(approval_date) between $P{from} and $P{to} and status='APPROVED' and farmer_no=$P{farmerNo};]]>
	</queryString>
