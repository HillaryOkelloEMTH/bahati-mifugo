	<queryString>
		<![CDATA[select round(sum(c.quantity), 2) as quantity, round(sum(c.amount), 2) as amount, u.user_name as collector, count(*) as collectionsCount from collections c join users u on u.id=c.collector_id where MONTHNAME(c.collection_date)=$P{month} and YEAR(c.collection_date)=$P{year} and c.session=$P{session} group by c.collector_id]]>
	</queryString>
