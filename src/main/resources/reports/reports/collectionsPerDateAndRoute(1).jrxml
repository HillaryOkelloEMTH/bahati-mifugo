	<parameter name="date" class="java.lang.String"/>
	<parameter name="route" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ROUND(SUM(c.amount), 2) AS amount, ROUND(SUM(c.quantity), 2) AS quantity, a.username AS collector FROM collections c JOIN collector a ON a.id = c.collector_id JOIN route r ON r.id = c.route_fk WHERE DATE(c.collection_date)=$P{date} AND r.route = $P{route} GROUP BY r.id]]>
	</queryString>
