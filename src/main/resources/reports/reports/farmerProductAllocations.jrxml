	<parameter name="paid" class="java.lang.Double"/>
	<queryString>
		<![CDATA[SELECT p.name as product, CONVERT(a.farmer_no,CHAR)as farmer_no  ,COALESCE(ROUND(a.amount ,2),0.0) as amount,IFNULL (a.quantity,'-') as quantity ,a.status,IFNULL(DATE_FORMAT(a.heat_start_date,'%Y-%m-%d'),'-')as heat_start_date ,IFNULL(a.no_of_cows,'-') as noOfCows,a.`type` ,DATE_FORMAT(a.allocatio_date ,'%Y-%m-%d') as allocationDate from farmer_product_allocations a join product p on p.id =a.product_id WHERE MONTHNAME(a.allocatio_date)=$P{month}  and a.farmer_no =$P{farmer_no}]]>
	</queryString>
