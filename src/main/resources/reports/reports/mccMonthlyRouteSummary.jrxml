<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CollectionsPerLocation" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="99c9f335-bd21-414a-9322-ce6c374a18c7">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="302"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="688"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="bahati"/>
	<parameter name="company" class="java.lang.String"/>
	<parameter name="location" class="java.lang.String"/>
	<parameter name="address" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="month" class="java.lang.String"/>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="mccId" class="java.lang.Long"/>
	<parameter name="mcc" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	ROUND(SUM(c.amount), 2) AS amount,
	ROUND( SUM(c.quantity), 2) AS quantity,
	ROUND(SUM(CASE WHEN c.session='Session 1' THEN quantity ELSE 0 END), 2) AS Session_1,
	ROUND(SUM(CASE WHEN c.session='Session 2' THEN quantity ELSE 0 END), 2) AS Session_2,
	ROUND(SUM(CASE WHEN c.session='Session 3' THEN quantity ELSE 0 END), 2) AS Session_3,
	r.route AS route 
FROM
	collections c
	JOIN route r ON r.id = c.route_fk
	join pick_up_locations pul on r.location_id=pul.id
WHERE
	monthname( c.collection_date )= $P{month}
	and year(c.collection_date) = $P{year}
	and pul.id= $P{mccId}
GROUP BY
	r.id]]>
	</queryString>
