	<parameter name="company" class="java.lang.String"/>
	<parameter name="location" class="java.lang.String"/>
	<parameter name="address" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="month" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT f.farmer_no, f.username, b.branch, b.account_number, ((COALESCE(SUM(c.amount), 0.0)) -(COALESCE(SUM(a.advance_amount), 0.0))) AS net_payable FROM farmer f LEFT JOIN bank_details b ON f.bank_details_id = b.id LEFT JOIN advance_payment a ON f.farmer_no = a.farmer_no LEFT JOIN collections c ON f.farmer_no = c.farmer_no WHERE f.farmer_no IS NOT NULL AND (LOWER(f.payment_mode) = 'bank' OR LOWER(f.payment_mode)='sacco') AND MONTHNAME(c.collection_date) = $P{month} AND YEAR(c.collection_date) = YEAR(NOW()) GROUP BY f.farmer_no;]]>
	</queryString>
