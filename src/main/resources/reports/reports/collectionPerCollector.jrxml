	<parameter name="date" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT sum(c.amount) as amount ,CAST(SUM(c.quantity)as DECIMAL(5,2)) as quantity,u.user_name as collector,count(*) as ColectionsCount  from collections c join users u on u.id=c.collector_id    where DATE(c.collection_date)=$P{date}   GROUP BY c.collector_id]]>
	</queryString>
