	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Jufred Database.jrdax"/>
	<parameter name="company" class="java.lang.String"/>
	<parameter name="location" class="java.lang.String"/>
	<parameter name="address" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="month" class="java.lang.String"/>
	<parameter name="year" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ROUND(SUM(c.quantity),2) as quantity, ROUND(SUM(c.amount),2) AS amount, ROUND(SUM(CASE WHEN c.session='Session 1' THEN quantity ELSE 0 END),2) AS Session_1, ROUND(SUM(CASE WHEN c.session='Session 2' THEN quantity ELSE 0 END), 2) AS Session_2, ROUND(SUM(CASE WHEN c.session='Session 3' THEN quantity ELSE 0 END),2) AS Session_3, r.route as route FROM collections c JOIN route r on r.id=c.route_fk WHERE MONTHNAME(c.collection_date)=$P{month} AND YEAR(c.collection_date)=$P{year} GROUP BY r.id;]]>
	</queryString>
