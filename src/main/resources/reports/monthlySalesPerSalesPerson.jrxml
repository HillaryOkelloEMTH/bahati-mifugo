	<parameter name="company" class="java.lang.String"/>
	<parameter name="location" class="java.lang.String"/>
	<parameter name="address" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="month" class="java.lang.String"/>
	<parameter name="sales_person" class="java.lang.String"/>
	<parameter name="year" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ROUND(SUM(s.quantity), 2) AS quantity, ROUND(SUM(s.amount), 2) AS amount, ROUND((SUM(s.amount))-(SUM(s.quantity*45)), 2) AS profit, DATE(s.created_on) AS date FROM sales s JOIN users u ON s.sales_person_fk=u.id WHERE u.user_name=$P{sales_person} AND MONTHNAME(s.created_on)=$P{month} AND YEAR(s.created_on)=$P{year} GROUP BY DATE(s.created_on);]]>
	</queryString>
