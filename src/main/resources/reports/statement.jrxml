	<queryString>
		<![CDATA[SELECT c.collection_number, c.amount, c.quantity, DATE_FORMAT(c.collection_date, '%Y-%m-%d %T') AS collection_date, c.session from collections c join farmer f on f.farmer_no=c.farmer_no WHERE date(c.collection_date) between date($P{from}) AND date($P{to}) and f.farmer_no=$P{farmerNo} AND c.payment_status='N']]>
	</queryString>
